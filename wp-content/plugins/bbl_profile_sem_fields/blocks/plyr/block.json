{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "bebelume/plyr",
    "version": "1.0.0",
    "title": "Bebelume Plyr",
    "category": "bebelume",
    "description": "Player de vídeo Plyr com opções completas de personalização.",
    "keywords": ["video", "plyr", "player", "bebelume"],
    "textdomain": "bebelume-profile",
    "editorScript": "file:./index.js",
    "style":        "file:./style.css",
    "render":       "file:./render.php",
    "attributes": {
        "videoUrl":       { "type": "string",  "default": "" },
        "videoType":      { "type": "string",  "default": "html5" },
        "posterUrl":      { "type": "string",  "default": "" },
        "title":          { "type": "string",  "default": "" },
        "autoplay":       { "type": "boolean", "default": false },
        "muted":          { "type": "boolean", "default": false },
        "loop":           { "type": "boolean", "default": false },
        "autopause":      { "type": "boolean", "default": true },
        "playsinline":    { "type": "boolean", "default": true },
        "clickToPlay":    { "type": "boolean", "default": true },
        "hideControls":   { "type": "boolean", "default": true },
        "seekTime":       { "type": "number",  "default": 10 },
        "volume":         { "type": "number",  "default": 1 },
        "speed":          { "type": "number",  "default": 1 },
        "ratio":          { "type": "string",  "default": "16:9" },
        "ctrlPlayLarge":  { "type": "boolean", "default": true },
        "ctrlRestart":    { "type": "boolean", "default": false },
        "ctrlRewind":     { "type": "boolean", "default": false },
        "ctrlPlay":       { "type": "boolean", "default": true },
        "ctrlFastFwd":    { "type": "boolean", "default": false },
        "ctrlProgress":   { "type": "boolean", "default": true },
        "ctrlCurrentTime":{ "type": "boolean", "default": true },
        "ctrlDuration":   { "type": "boolean", "default": true },
        "ctrlMute":       { "type": "boolean", "default": true },
        "ctrlVolume":     { "type": "boolean", "default": true },
        "ctrlCaptions":   { "type": "boolean", "default": false },
        "ctrlSettings":   { "type": "boolean", "default": true },
        "ctrlPip":        { "type": "boolean", "default": false },
        "ctrlAirplay":    { "type": "boolean", "default": false },
        "ctrlFullscreen": { "type": "boolean", "default": true },
        "colorMain":      { "type": "string",  "default": "" },
        "colorControl":   { "type": "string",  "default": "" },
        "colorControlHover": { "type": "string", "default": "" },
        "colorControlBgHover": { "type": "string", "default": "" },
        "colorProgress":  { "type": "string",  "default": "" }
    }
}
