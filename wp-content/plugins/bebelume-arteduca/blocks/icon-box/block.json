{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "bebelume-arteduca/icon-box",
  "version": "1.2.0",
  "title": "Bebelume Icon Box",
  "category": "bebelume-arteduca",
  "icon": "admin-appearance",
  "description": "Caixa com ícone Lucide e texto lado a lado",
  "supports": {
    "html": false,
    "anchor": true
  },
  "attributes": {
    "icone": {
      "type": "string",
      "default": "heart"
    },
    "texto": {
      "type": "string",
      "default": "Digite seu texto aqui..."
    }
  },
  "textdomain": "bebelume-arteduca",
  "editorScript": "file:./block.js",
  "style": "file:./style.css"
}
